# Production environment template.
# Copy values into Cloudflare/Render dashboards. Do not commit real secrets.

# Backend
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DB_AUTO_CREATE=0
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://yourdomain.com,https://portal.yourdomain.com
CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?yourdomain\.com$
APP_PUBLIC_BASE_URL=https://yourdomain.com

# Admin bootstrap
PHARMACY_ADMIN_EMAIL=admin@yourdomain.com
PHARMACY_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
PHARMACY_ADMIN_FULL_NAME=Admin

# AI
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_MAIN_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
OPENROUTER_EMBED_DIM=1536
OPENROUTER_HTTP_REFERER=https://yourdomain.com
OPENROUTER_X_TITLE=Pharmacy Assistant

# RAG
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
RAG_MIN_SCORE_SHORT=0.15
RAG_RETRIEVAL_MODE=vector
RAG_EMBEDDINGS_ENABLED=1
RAG_SOURCES_MAX_CHARS=6000

# Cloudflare R2 prescription storage
PRESCRIPTION_STORAGE=r2
PRESCRIPTION_MAX_UPLOAD_BYTES=10485760
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pharmacy-prescriptions
R2_REGION=auto

# Email
RESEND_API_KEY=
RESEND_FROM=Pharmacy <no-reply@yourdomain.com>
ENABLE_APPOINTMENT_REMINDERS=true
REMINDER_POLL_SECONDS=300

# Frontend build variables
VITE_API_URL=https://api.yourdomain.com
VITE_PORTAL_HOSTS=portal.yourdomain.com
